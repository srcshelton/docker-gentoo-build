#! /usr/bin/env bash

set -eu
set -o pipefail

trace="${TRACE:-}"
debug="${DEBUG:-}"
[[ -z "${trace}" ]] || set -o xtrace
# With 'debug' enabled, set 'DEBUG_EXTRA_ARGS' to pass additional arguments
# to 'podman build'...
#DEBUG_EXTRA_ARGS=''

# If the python release(s) used in the upstream stage3 image differ from those
# we wish to build against or those specified in the host's
# /etc/portage/package.use file(s), then 'python_targets_override' must be set
# to the desired release below.
#
# Use the default targets only when neither the command-line environment, an
# optional 'python_targets_override', nor the host's Portage configuration
# specifies any alternate values:
#
declare -r python_targets_default='python3_14 python3_14t'
declare -x python_targets_override

if [[ -n "${BASH_VERSINFO[0]:-}" ]] && (( BASH_VERSINFO[0] < 4 )); then
	echo >&2 "FATAL: bash-4.0.0 or later is required to run this script - on" \
		"macOS, try 'brew install bash'"
	exit 1
fi

if [[ "$( uname -s )" == 'Darwin' ]]; then
	# Darwin/BSD lacks GNU readlink - either realpath or perl's Cwd module
	# will do at a pinch, although both lack the additional options of GNU
	# binaries...
	#
	readlink() {
		if type -pf realpath >/dev/null 2>&1; then
			realpath "${2}"
		else
			# The perl statement below returns $PWD if the supplied
			# path doesn't exist :(
			[[ -e "${2}" ]] || return 1
			perl -MCwd -le 'print Cwd::abs_path shift' "${2}"
		fi
	}  # readlink
	export -f readlink
fi
cd "$( dirname "$( readlink -e "${0}" )" )" || exit 1

# From buildah-1.33.0/podman-4.8.0, Docker syntax 1.3-labs/1.4 HEREDOC support
# is available...
#
select_file() {
	local file="${1:-}"

	[[ -n "${file:-}" ]] || return 1
	[[ -n "${docker_version:-}" ]] || return 1

	if [[ "${_container_engine:-}" == 'podman' ]] && [[ "$( # <- Syntax
			printf '%s\n' '4.8.0' "${docker_version}" | sort -V | head -n 1
		)" == '4.8.0' ]]
	then
		if [[ -s "${PWD%"${base_dir:-}"}/${base_dir:+"${base_dir}/"}${file}-1.4" ]]
		then
			file+='-1.4'
		elif ! [[ -s "${PWD%"${base_dir:-}"}/${base_dir:+"${base_dir}/"}${file}" ]]
		then
			return 66 # EX_NOINPUT "cannot open input"
		fi
	fi

	printf '%s' "${file}"

	return 0
}  # select_file

declare -i NOTIFY_MKDIR=0

# Set by common/vars.sh
#
#declare docker='docker'
#declare mail_from=''
#declare mail_to=''
#declare mail_mta=''
#declare env_name=''
#declare stage3_name=''
#declare init_name=''
#declare base_name=''
#declare build_name=''
#declare stage3_flags_file=''
#declare environment_file=''
#declare environment_filter=''
#declare base_dir=''
#declare use_cpu_arch=''
#declare cc_target_opts=''
#declare rust_target_opts=''
#declare use_cpu_flags=''
#declare use_cpu_flags_raw=''
#declare use_essential=''
#declare use_essential_gcc=''
#declare python_default_target=''
#declare JOBS=''
#declare MAXLOAD=''
#declare bold=''
#declare red=''
#declare blue=''
#declare purple=''
#declare reset=''

# Set by common/run.sh _docker_setup()
#
#declare docker_arch=''
#declare arch=''
#declare profile_version=''

# pkg_pypy, pkg_pypy_use & pkg_pypy_post_remove are defined in common/vars.sh
#declare pkg_pypy=''
#declare pkg_pypy_use=''
#declare pkg_pypy_post_remove=''

# shellcheck disable=SC1091
[[ ! -s common/vars.sh ]] || . common/vars.sh
# shellcheck disable=SC2034  # Set from common/vars.sh
[[ -n "${__COMMON_VARS_INCLUDED:-}" ]] || {
		echo >&2 "FATAL: Inclusion of common defaults from" \
			"'${PWD}/common/vars.sh' failed"
		exit 1
	}

[[ -n "${base_dir:-}" ]]
[[ -d "${base_dir}" ]]
[[ -e "${base_dir}"/Dockerfile.env ]]
[[ -e "${base_dir}"/Dockerfile.stage3 ]]
[[ -e "${base_dir}"/Dockerfile.init ]]
[[ -e "${base_dir}"/Dockerfile.build ]]

# shellcheck disable=SC2034,SC2154
IMAGE="${base_name}:${override_tag:-"latest"}"
# shellcheck disable=SC1091
[[ -s common/run.sh ]] && . common/run.sh >/dev/null
if [[ "$( type -t 'die' )" != 'function' ]]; then
	echo >&2 "FATAL: Unable to source shared functions from" \
		"'common/run.sh'"
	exit 127
fi
# shellcheck disable=SC1091
[[ -s common/build-flags.sh ]] && . common/build-flags.sh
if [[ "$( type -t 'resolve_non_gentoo_build_flags' )" != 'function' ]] ||
		[[ "$( type -t 'resolve_gentoo_build_flags' )" != 'function' ]]
then
	die "Unable to source compiler flag resolvers from 'common/build-flags.sh'"
fi

if [[ -n "${*:-}" ]]; then
	if grep -Eq -- ' -(h|-help) ' <<<" ${*} "; then
		output >&2 "Usage: $( basename "${0}" ) [--env] [--stage3] [--init]" \
			"[[--force] --base] [[--force] --build] [--helper [--force-helper]]" \
			"[--print-pkgdir-cache-affinity]"
		output >&2
		output >&2 'Linux compiler flags retain their normal Portage meaning.'
		output >&2 'On macOS, ambient compiler flags are ignored unless explicitly'
		output >&2 'set as GENTOO_BUILD_<FLAG>, or retained together by setting'
		output >&2 'GENTOO_USE_HOST_COMPILER_FLAGS=1.'
		output >&2 'Cache-affinity queries pull the pinned stage3 and ask its GCC'
		output >&2 'to resolve the build runner CPU into explicit compiler flags.'
		container_engine_help >&2
		exit 0
	elif ! grep -Eq <<<" ${*} " -- \
		'^(\s*--(env|stage3|init|base|build|helper|force|force-helper|print-pkgdir-cache-affinity)\s*){1,7}$'
	then
		die "Unknown args '${*}'"
	fi

	if grep -Fq -- ' --force ' <<<" ${*} "; then
		if ! grep -Eq -- ' --(base|build|helper) ' <<<" ${*} "; then
			die "'--force' is only valid with '--base', '--build', or" \
				"'--helper'"
		fi
	fi
fi

# N.B. Image names, not file names...
#
if [[ -z "${env_name:-}" ]] ||
		[[ -z "${stage3_name:-}" ]] ||
		[[ -z "${init_name:-}" ]] ||
		[[ -z "${base_name:-}" ]] ||
		[[ -z "${build_name:-}" ]]
then
	die "Image names not correctly set in '$( pwd )/common/vars.sh'"
fi

declare target_opt=''
declare rust_target_opt=''
declare -i build_helper=0
declare -i force=0
declare -i print_pkgdir_cache_affinity=0

if grep -Fq -- ' --print-pkgdir-cache-affinity ' <<<" ${*:-} "; then
	[[ "${*:-}" == '--print-pkgdir-cache-affinity' ]] ||
		die "'--print-pkgdir-cache-affinity' cannot be combined with build stages"
	print_pkgdir_cache_affinity=1
fi

declare docker_version=''
if (( print_pkgdir_cache_affinity )); then
	docker_version='not-required'
elif [[ "${_container_engine}" == 'container' ]]; then
	docker_version="$( # <- Syntax
			container_engine_run "${_command}" --version |
				grep -ow 'version [0-9.]\+' |
				cut -d' ' -f2-
		)" || die "Cannot determine ${_command} version: ${?}"
else
	docker_version="$( # <- Syntax
			container_engine_run "${_command}" version \
				--format '{{.Client.Version}}'
		)" || die "Cannot determine ${_command} version: ${?}"
fi
readonly docker_version

declare python_single_target="${PYTHON_SINGLE_TARGET:-}"
declare python_targets="${PYTHON_TARGETS:-}"

if [[ -n "${python_targets_override:-}" ]]; then
	[[ -n "${python_single_target}" ]] ||
		python_single_target="${python_targets_override%%" "*}"
	[[ -n "${python_targets}" ]] ||
		python_targets="${python_targets_override}"
fi

if type -pf portageq >/dev/null 2>&1; then
	if [[ -z "${python_single_target}" ]]; then
		python_single_target="$( portageq envvar 'PYTHON_SINGLE_TARGET' )"
	fi
	if [[ -z "${python_targets}" ]]; then
		python_targets="$( portageq envvar 'PYTHON_TARGETS' )"
	fi
fi

[[ -n "${python_targets}" ]] ||
	python_targets="${python_targets_default}"
[[ -n "${python_single_target}" ]] ||
	python_single_target="${python_targets%%" "*}"

export PYTHON_SINGLE_TARGET="${python_single_target}"
export PYTHON_TARGETS="${python_targets}"

declare mask_file=''
if [[ -n "${arch:-}" ]] &&
	[[ -f "${base_dir}/etc/portage/profile/use.mask.${arch}" ]]
then
	mask_file="${base_dir}/etc/portage/profile/use.mask.${arch}"
fi
[[ -z "${mask_file:-}" ]] &&
	mask_file="${base_dir}/etc/portage/profile/use.mask"
if [[ -n "${python_single_target:-}" ]]; then
	[[ "${python_single_target}" =~ ^python[[:digit:]]_[[:digit:]]+$ ]] ||
		die "python_single_target value '${python_single_target}'" \
			"doesn't appear to be a valid python version" \
			"(matching 'pythonX_Y', e.g. 'python3_14')"
	if [[ -f "${mask_file}" ]]; then
		if sed 's/#.*$//' "${mask_file}" |
			grep -qw -- "^python_single_target_${python_single_target}"
		then
			die "python_single_target value" \
				"'python_single_target_${python_single_target}'" \
				"is masked by '${mask_file}'"
		fi
	fi
fi
if [[ -n "${python_targets:-}" ]]; then
	for python_target in ${python_targets}; do
		[[ "${python_target}" =~ ^python[[:digit:]]_[[:digit:]]+t?$ ]] ||
			die "python_targets value '${python_target}'" \
				"doesn't appear to be a valid python version" \
				"(matching 'pythonX_Y(t)', e.g. 'python3_14t')"
		if [[ -f "${mask_file}" ]]; then
			if sed 's/#.*$//' "${mask_file}" |
				grep -qw -- "^python_targets_${python_target}"
			then
				die "python_targets value 'python_targets_${python_target}'" \
					"is masked by '${mask_file}'"
			fi
		fi
	done
fi
unset mask_file

declare -a args=()
for arg in "${@:-}"; do
	case "${arg:-}" in
		--print-pkgdir-cache-affinity)
			: ;;
		*helper)
			build_helper=1
			args+=( "${arg}" )
			;;
		--force)
			force=1
			;;
		*)
			args+=( "${arg}" )
			;;
	esac
done
set -- "${args[@]:-}"
unset args arg

_docker_setup

pushd "${base_dir}" >/dev/null 2>&1 ||
	die "chdir() to '${base_dir}' failed; ${?}"

checklabel() {
	local image="${1:-}"
	local label="${2:-}"
	local value="${3:-}"
	local label_value=''

	if [[ -z "${image:-}" ]]; then
		error "Image name not set"
		return 1
	fi
	if [[ -z "${label:-}" ]]; then
		error "Label name not set"
		return 1
	fi
	if [[ -z "${value:-}" ]]; then
		warn "Value not set"
	fi

	if ! [[ "${image}" =~ / ]]; then
		image="localhost/${image}"
	fi
	if [[ "${image}" =~ ^localhost/localhost/ ]]; then
		warn "${FUNCNAME[0]}: Correcting over-specified image '${image}'" \
			"from ${FUNCNAME[1]}"
		image="${image#"localhost/"}"
	fi
	if ! [[ "${image}" =~ : ]]; then
		image="${image}:${override_tag:-"latest"}"
	fi

	if [[ "${value}" =~ :SHA256: ]]; then
		print "${FUNCNAME[0]}: Correcting digest from '${value}' to" \
			"'${value/:SHA256:/@SHA256:}'"
		value="${value/:SHA256:/@SHA256:}"
	fi

	label_value="$( # <- Syntax
		if [[ "${_container_engine}" == 'container' ]]; then
			apple_image_label "${image}" "${label}"
		else
			docker image inspect \
					--format="{{index .Config.Labels \"${label}\"}}" \
				"${image}" 2>/dev/null
		fi
	)"
	if ! [[ "${label_value:-}" == "${value}" ]]; then
		echo "${label_value:-}"
		return 1
	else
		return 0
	fi
}  # checklabel

checkids() {
	local name="${1:-}"
	local tag="${2:-"${override_tag:-"latest"}"}"

	#inherit docker stage3_name env_id env_name gentoo_stage3_id bold reset red
	local repo='' images='' stage3_env_id='' stage3_src_id=''

	if [[ -z "${name:-}" ]]; then
		error "Image name not set"
		return 1
	fi
	if [[
		-z "${_command:-}" ||
		-z "${stage3_name:-}" ||
		-z "${env_name:-}" ||
		-z "${env_id:-}"
	]]; then
		error "Required global variable not set"
		return 1
	fi

	local relation="inherited by"
	if [[ "${name#*"/"}" == "${stage3_name#*"/"}" ]]; then
		relation="about to be linked to"
	fi

	if ! [[ "${name}" =~ / ]]; then
		repo='localhost/'
	fi
	images="$( docker image ls --noheading \
		"${repo}${name}:${tag}" 2>/dev/null
	)"
	# Older releases of 'podman' exclude the repo when it is 'localhost/'...
	# FIXME: Can't we just check whether 'images' is set?
	if grep -Eq -- "^(${repo:-"${name%"/"*}"})?${name#*"/"}" <<<"${images}"
	then
		if stage3_env_id="$( # <- Syntax
				stage3_repo=''
				if ! [[ "${stage3_name}" =~ / ]]; then
					stage3_repo='localhost/'
				fi
				if [[ "${_container_engine}" == 'container' ]]; then
					apple_image_label \
						"${stage3_repo:-}${stage3_name}:${tag}" \
						'environment-from'
				else
					docker image inspect \
							--format='{{index .Config.Labels "environment-from"}}' \
						"${stage3_repo:-}${stage3_name}:${tag}" 2>/dev/null
				fi
			)" && [[ -n "${stage3_env_id:-}" ]]
		then
			stage3_env_id="$( echo "${stage3_env_id:-}" | cut -d':' -f 2- )"

			# Does our current 'gentoo-env' image match the ID encoded in our
			# local stage3?
			# N.B.: 'env_id' inherited from global scope
			if [[ "${env_id}" != "${stage3_env_id:-}" ]]; then
				output >&2 "${bold:-}WARN${reset:-}:  ${red:-}" \
					"The current '${env_name#*"/"}' image (${env_id})" \
					"differs from that used to build the" \
					"'${stage3_name#*"/"}' image (${stage3_env_id:-})" \
					"${relation} this stage${reset:-}"
			fi
		fi

		if [[ -n "${gentoo_stage3_id:-}" ]]; then
			# N.B.: Only valid for our 'init' and (local) 'stage3' images
			if stage3_src_id="$( # <- Syntax
					if [[ "${_container_engine}" == 'container' ]]; then
						apple_image_label \
							"${repo}${name}:${tag}" \
							'stage3-from'
					else
						docker image inspect \
								--format='{{index .Config.Labels "stage3-from"}}' \
							"${repo}${name}:${tag}" 2>/dev/null
					fi
			)" && [[ -n "${stage3_src_id:-}" ]]
			then
				stage3_src_id="${stage3_src_id#"${gentoo_stage3_image}:"}"

				# Does our upstream stage3 match the ID encoded in our current
				# image?
				if [[ "${gentoo_stage3_id}" != "${stage3_src_id:-}" ]]; then
					output >&2 "${bold:-}WARN${reset:-}:  ${red:-}" \
						"The upstream 'stage3' image (${gentoo_stage3_id})" \
						"differs from that used to build the '${name#*"/"}'" \
						"image (${stage3_src_id:-}) ${relation} this" \
						"stage${reset}"
				fi
			fi
		fi
	fi

	# The above is a warning rather than an error, so...
	return 0
}  # checkids

apple_image_label() {
	[[ "${_container_engine}" == 'container' ]] || return 1
	[[ -n "${1:-}" && -n "${2:-}" ]] || return 1

	container_engine_run "${_command}" image inspect "${1}" 2>/dev/null |
		jq -er --arg label "${2}" '
			[
				if type == "array" then .[] else . end |
				.variants[]?.config.config.Labels[$label]? //
				.config.config.Labels[$label]? //
				.config.Labels[$label]? //
				empty
			][0] // empty
		'
}  # apple_image_label

apple_image_digest() {
	[[ "${_container_engine}" == 'container' ]] || return 1
	[[ -n "${1:-}" ]] || return 1

	container_engine_run "${_command}" image inspect "${1}" 2>/dev/null |
		jq -er '
			[
				if type == "array" then .[] else . end |
				.configuration.descriptor.digest? //
				.index.digest? //
				.variants[]?.descriptor.digest? //
				.variants[]?.digest? //
				.descriptor.digest? //
				.digest? //
				.id? //
				empty
			][0] // empty
		'
}  # apple_image_digest

makedir() {
	local dir="${1:-}"

	[[ -n "${dir}" ]] || return 1

	if ! (( NOTIFY_MKDIR )) && (( EUID )); then
		NOTIFY_MKDIR=1

		info "In order to run on a non-gentoo system, we need to create" \
			"several system"
		info "directories."
		info "You may be now prompted to enter your password in order to" \
			"authenticate"
		info "with superuser credentials and allow for this to proceed:"
	fi

	if [[ "$( uname -s )" == 'Darwin' ]] || (( EUID )); then
		sudo mkdir -pm 0755 "${dir}" || die "mkdir() on '${dir}' failed: ${?}"
		sudo chown ${EUID} "${dir}" || die "chown() on '${dir}' failed: ${?}"
	else
		mkdir -p "${dir}" || die "mkdir() on '${dir}' failed: ${?}"
	fi

	info " * ${dir}"
}  # makedir

declare repo_path_srcshelton=''

# Check for environment sanity...
if ! type -pf portageq >/dev/null 2>&1; then
	warn "Not running on Gentoo host system, not checking eclass overrides"

	# shellcheck disable=SC2043
	for dir in 'repos.conf' 'package.mask' 'savedconfig'; do
		[[ -d "/etc/portage/${dir}" ]] || makedir "/etc/portage/${dir}"
	done
	unset dir
	for cfg in DEFAULT.conf gentoo.conf srcshelton.conf; do
		[[ -s /etc/portage/repos.conf/${cfg} ]] ||
			cp -v etc/portage/repos.conf/${cfg} /etc/portage/repos.conf/
	done
	unset cfg

	declare -i private_gentoo_clone=0
	declare repo_path_gentoo='/var/db/repo/gentoo'
	repo_path_srcshelton='/var/db/repo/srcshelton'

	# FIXME: Hardcoded paths, use repos.conf
	if
		[[ ! -d "${repo_path_gentoo}" ]] &&
			[[ ! -d /var/db/repos/gentoo ]]
	then
		# macOS 'df' lacks the below options
		if [[ "$( uname -s )" != 'Darwin' ]]; then
			for dir in /var/db/repo{,s} /var/db; do
				if [[ -d "${dir}" ]]; then
					# FIXME: Figure out best macOS implementation
					if (( $( # <- Syntax
						df --block-size=1G --output=avail "${dir}" |
						tail -n 1
					) < 2 )); then
						die "Insufficient filesystem space to download" \
							"Gentoo Portage repo: 2GB required"
					fi
					break
				fi
			done
			unset dir
		fi

		type -pf git >/dev/null 2>&1 || die "required binary 'git' missing"

		note "Creating local Gentoo Portage repo mirror at" \
			"'${repo_path_gentoo}' ..."

		# shellcheck disable=SC2043,SC2066
		for dir in "$( dirname "${repo_path_gentoo}" )"; do
			[[ -d "${dir}" ]] || makedir "${dir}"
		done
		unset dir

		git clone https://github.com/gentoo/gentoo.git "${repo_path_gentoo}" ||
			die "git 'clone' operation failed: ${?}"
		if ! git config --global --get-all safe.directory |
			grep -q "${repo_path_gentoo%"/"}"
		then
			git config --global --add safe.directory "${repo_path_gentoo}" ||
				die "git safe directory addition of '${repo_path_gentoo}'" \
					"failed: ${?}"
		fi

		private_gentoo_clone=1

	elif [[ -d /var/db/repos/gentoo ]]; then
		repo_path_gentoo='/var/db/repos/gentoo'
	fi

	if
		[[ ! -d "${repo_path_srcshelton}" ]] &&
			[[ ! -d /var/db/repos/srcshelton ]]
	then
		type -pf git >/dev/null 2>&1 || die "required binary 'git' missing"

		note "Creating custom packages repo mirror at" \
			"'${repo_path_srcshelton}' ..."

		# shellcheck disable=SC2043,SC2066
		dir="$( dirname "${repo_path_srcshelton}" )"
		[[ -d "${dir}" ]] || makedir -p "${dir}"
		unset dir

		git clone \
				https://github.com/srcshelton/gentoo-ebuilds.git \
				"${repo_path_srcshelton}" ||
			die "git 'clone' operation failed: ${?}"
		if ! git config --global --get-all safe.directory |
			grep -q "${repo_path_srcshelton%"/"}"
		then
			git config --global --add safe.directory \
					"${repo_path_srcshelton}" ||
				die "git safe directory addition of" \
					"'${repo_path_srcshelton}' failed: ${?}"
		fi

	elif [[ -d /var/db/repos/srcshelton ]]; then
		repo_path_srcshelton='/var/db/repos/srcshelton'
	fi

	declare ref=''
	if
		[[ -s "${repo_path_srcshelton}/.portage_commit" ]] &&
			ref="$( # <- Syntax
				grep -Fv '#' "${repo_path_srcshelton}/.portage_commit"
			)" &&
				[[ -n "${ref:-}" ]]
	then
		if ! git config --global --get-all safe.directory |
			grep -q "${repo_path_gentoo%"/"}"
		then
			git config --global --add safe.directory "${repo_path_gentoo}" ||
				die "git safe directory addition of '${repo_path_gentoo}'" \
					"failed: ${?}"
		fi
		pushd "${repo_path_gentoo}" >/dev/null 2>&1
		declare head=''
		head="$( git rev-parse HEAD )"
		if [[ "${ref}" == "${head:-}" ]]; then
			note "Local Gentoo Portage repo mirror is in sync with custom" \
				"packages repo at commit '${ref:0:7}'"
		elif git rev-parse -q --verify "${ref}^{commit}" >/dev/null 2>&1; then
			info "Local Gentoo Portage repo mirror is currently at commit" \
				"'${head:0:7}' but can be reverted to custom packages repo" \
				"target commit '${ref:0:7}'"
			if (( private_gentoo_clone )); then
				if git reset --hard "${ref}"; then
					info "Local Gentoo Portage repo mirror is now in sync" \
						"with custom packages repo at commit '${ref:0:7}'"
				else
					error "Unable to reset local Gentoo Portage repo mirror" \
						"to commit '${ref:0:7}': ${?}"
				fi
			else
				warn "Not changing local Gentoo Portage repo mirror contents" \
					"for potentailly shared clone"
			fi
		else
			error "Custom packages target commit '${ref:0:7}' does not exist" \
				"in local Gentoo Portage repo mirror - mirror out of date?"
		fi
		unset head
		# Return from ${repo_path_gentoo}
		popd >/dev/null 2>&1
	fi
	unset ref

	portage_log_dir="${PORTAGE_LOGDIR:-"${PORT_LOGDIR:-"$( # <- Syntax
			command -v portageq >/dev/null 2>&1 &&
				portageq envvar PORTAGE_LOGDIR 2>/dev/null || :
		)"}"}"
	# shellcheck disable=SC2154 # profile_version set by _docker_setup
	# The resolver's ARCH/GENTOO_PKGHOST assignments are intentionally confined
	# to its subshell.
	# shellcheck disable=SC2031
	declare default_pkgdir_path="${PKGDIR_OVERRIDE:-}"
	# shellcheck disable=SC2031
	[[ -n "${default_pkgdir_path}" ]] ||
		default_pkgdir_path="/var/cache/portage/pkg/${ARCH:-"${arch}"}/${GENTOO_PKGHOST:-"container"}/${profile_version}"
	for dir in /var/cache/portage/dist \
			"${portage_log_dir:-"/var/log/portage"}" \
			"${default_pkgdir_path}"
	do
		[[ -d "${dir}" ]] || makedir "${dir}"
	done
	unset default_pkgdir_path dir portage_log_dir

	unset private_gentoo_clone repo_path_gentoo

	# Return from ${base_dir}
	popd >/dev/null 2>&1

	# Flags may have changed...
	unset __COMMON_VARS_INCLUDED

	# shellcheck disable=SC1091
	[[ ! -s common/vars.sh ]] || . common/vars.sh
	# shellcheck disable=SC2034 # Set from common/vars.sh
	[[ -n "${__COMMON_VARS_INCLUDED:-}" ]] || {
		echo >&2 "FATAL: Inclusion of common defaults from" \
			"'${PWD}/common/vars.sh' failed"
		exit 1
	}

	pushd "${base_dir}" >/dev/null 2>&1 ||
		die "chdir() to '${base_dir}' failed; ${?}"

else # type -pf portageq >/dev/null 2>&1; then

	declare -i rc=0

	while read -r repo; do
		# FIXME: Discover default rather than assuming 'gentoo'?
		[[ "${repo}" == 'gentoo' ]] && continue

		while read -r dir; do
			if [[ -d "${dir}"/eclass ]]; then
				grep -hR eclass /etc/portage/repos.conf |
						sed 's/#.*//' |
						grep -- '^eclass-overrides' |
						cut -d '=' -f 2- |
						grep -Fqw -- "${repo}" &&
					continue
				warn "ebuild repo '${repo}' contains class overrides, but" \
					"portage isn't configured to allow their use"
				warn "Add/update 'eclass-overrides = ${repo}' in" \
					"/etc/portage/repos.conf"
				rc=1
			fi
		done < <( portageq get_repo_path "${EROOT:-"/"}" "${repo}" )
		unset dir

	done < <( portageq get_repos "${EROOT:-"/"}" | xargs -n 1 )
	unset repo

	(( rc )) && sleep 5
	unset rc

	# FIXME: Discover default rather than assuming 'gentoo'?
	declare repo_path_gentoo=''
	declare ref=''
	repo_path_gentoo="$( # <- Syntax
		portageq get_repo_path "${EROOT:-"/"}" 'gentoo' 2>/dev/null
	)"
	repo_path_srcshelton="$( # <- Syntax
		portageq get_repo_path "${EROOT:-"/"}" 'srcshelton' 2>/dev/null
	)"
	if
		[[ -n "${repo_path_gentoo:-}" && -d "${repo_path_gentoo}" ]] &&
			[[ -n "${repo_path_srcshelton:-}" && -d "${repo_path_srcshelton}" ]]
	then
		if
			[[ -s "${repo_path_srcshelton}/.portage_commit" ]] &&
				ref="$( # <- Syntax
					grep -Fv '#' "${repo_path_srcshelton}/.portage_commit"
				)" &&
					[[ -n "${ref:-}" ]]
		then
			if ! git config --global --get-all safe.directory |
				grep -q "${repo_path_gentoo%"/"}"
			then
				git config --global --add safe.directory "${repo_path_gentoo}" ||
					die "git safe directory addition of '${repo_path_gentoo}'" \
						"failed: ${?}"
			fi
			pushd "${repo_path_gentoo}" >/dev/null 2>&1
			declare head=''
			head="$( git rev-parse HEAD )"
			if [[ "${ref}" == "${head:-}" ]]; then
				note "Local Gentoo Portage repo mirror is in sync with" \
					"custom packages repo at commit '${ref:0:7}'"
			elif
				git rev-parse -q --verify "${ref}^{commit}" >/dev/null 2>&1
			then
				warn "Local Gentoo Portage repo mirror is currently at" \
					"commit '${head:0:7}' but can be reverted to custom" \
					"packages repo target commit '${ref:0:7}'"
			else
				error "Custom packages target commit '${ref:0:7}' does not" \
					"exist in local Gentoo Portage repo mirror - mirror out" \
					"of date?"
			fi
			unset head
			# Return from ${repo_path_gentoo}
			popd >/dev/null 2>&1
		else
			warn "No upstream commit marker found in" \
				"'${repo_path_srcshelton}/.portage_commit'"
		fi
	else
		die "Could not determine essential repo paths for 'gentoo'" \
			"(${repo_path_gentoo:-}) or 'srcshelton'" \
			"(${repo_path_srcshelton:-})"
	fi
	unset ref repo_path_gentoo
fi

# 'cut' separately to emulate 'pipefail' when using /bin/sh
#
# (... which we aren't any longer - but pipefail does seem to cause some
# unexpected behaviour)
#
command -v sha1sum >/dev/null 2>&1 || die "required binary 'sha1sum' missing"
declare sum=''
sum="$( sha1sum entrypoint.sh )"
sum="$( echo "${sum}" | cut -d' ' -f 1 )"
[[ -n "${sum}" ]] || die "Could not calculate 'entrypoint.sh' checksum"

prepare_gentoo_stage3_image() {
	local -i rc=0 need_pull=1
	local -a untag_args=()

	gentoo_stage3_image="$( # <- Syntax highlight failure
		grep -- '^ARG gentoo_stage3_image=' Dockerfile.stage3 |
			cut -d'"' -f 2
	)"
	ref=''
	trap '' INT

	# Pull explicitly so both the compiler probe and the later stage build use
	# the same architecture-specific, overlay-pinned image.
	if [[ "${gentoo_stage3_tag}" = 'latest' ]]; then
		info "Using upstream '${gentoo_stage3_image}' tag" \
			"'${gentoo_stage3_tag}'"

		case "$( docker image pull --help )" in
			*'--platform'*)
				docker image pull "${gentoo_stage3_image}:latest" \
					--platform "linux/${docker_arch}" || rc=${?}
				;;
			*'--override-arch'*)
				docker image pull "${gentoo_stage3_image}:latest" \
					--override-arch "${docker_arch}" || rc=${?}
				;;
			*'--arch'*)
				docker image pull "${gentoo_stage3_image}:latest" \
					--arch "${docker_arch}" || rc=${?}
				;;
			*)
				die "Could not determine method to retrieve" \
					"non-native architecture with" \
					"'${_command} image pull'"
				;;
		esac

		need_pull=0
	elif [[ -n "${repo_path_srcshelton:-}" ]] &&
			[[ -d "${repo_path_srcshelton}" ]]
	then
		if [[ -s "${repo_path_srcshelton}/.image_digests" ]]; then
			ref="$( # <- Syntax
				grep -m 1 "^${docker_arch} " \
						"${repo_path_srcshelton}/.image_digests" |
					cut -d' ' -f 2-
			)"
			if ! [[ "${ref%":"*}" == 'sha256' ]]; then
				warn "Unable to retrieve SHA256 digest for image" \
					"'${gentoo_stage3_image}:${gentoo_stage3_tag}' with" \
					"architecture '${docker_arch}' from file" \
					"'${repo_path_srcshelton}/.image_digests'"
				need_pull=1
			else
				info "Using '${gentoo_stage3_image}' pin '${ref}'"

				# Podman 4.6 can lose a digest when its tag is replaced.  Remove
				# the tag before pulling the immutable reference.
				if [[ "${_container_engine}" == 'podman' ]] && [[ -n "$( # <- Syntax
					docker image list \
						-q \
						--filter "reference=${gentoo_stage3_image}:${gentoo_stage3_tag}"
				)" ]]
				then
					untag_args=( image untag )
					[[ "${_container_engine}" != 'docker' ]] ||
						untag_args=( image rm )
					if ! docker "${untag_args[@]}" \
							"${gentoo_stage3_image}:${gentoo_stage3_tag}"
					then
						docker --debug "${untag_args[@]}" \
								"${gentoo_stage3_image}:${gentoo_stage3_tag}" ||
							die "${_command} image tag removal failed for" \
								"'${gentoo_stage3_image}:${gentoo_stage3_tag}' tag"
					fi
				fi

				info "Pulling image '${gentoo_stage3_image}@${ref}' ..."
				if ! docker image pull "${gentoo_stage3_image}@${ref}"; then
					docker --debug image pull "${gentoo_stage3_image}@${ref}" ||
						rc=${?}
				else
					info "Tagging '${ref}' as" \
						"'${gentoo_stage3_image}:${gentoo_stage3_tag}'"

					if ! docker image tag "${gentoo_stage3_image}@${ref}" \
							"${gentoo_stage3_image}:${gentoo_stage3_tag}"
					then
						docker --debug image tag \
							"${gentoo_stage3_image}@${ref}" \
							"${gentoo_stage3_image}:${gentoo_stage3_tag}" || :
						warn "Pull of pinned image failed - reverting to tag" \
							"'${gentoo_stage3_tag}'"
						need_pull=1
					else
						rc=0
						need_pull=0
					fi
				fi
			fi
		fi
	fi

	if (( need_pull )); then
		warn "Pulling image '${gentoo_stage3_image}:${gentoo_stage3_tag}' ..."
		if ! docker image pull "${gentoo_stage3_image}:${gentoo_stage3_tag}"; then
			rc=${?}
			docker --debug image pull \
				"${gentoo_stage3_image}:${gentoo_stage3_tag}" || rc=${?}
		fi
	fi

	trap - INT
	if (( rc )); then
		die "'${_command} image pull' failed to retrieve image" \
			"'${gentoo_stage3_image}:${gentoo_stage3_tag}' for architecture" \
			"'${docker_arch}'"
	fi

	# macOS 'container' has no image ID distinct from the SHA256 digest.
	if [[ -n "${ref:-}" ]]; then
		gentoo_stage3_id="$( # <- Syntax
			if [[ "${_container_engine}" == 'container' ]]; then
				echo "${ref}"
			else
				docker image ls --noheading --digests \
						--format='{{.Digest}} {{.ID}}' 2>/dev/null |
					grep -F -- "${ref}" |
					awk '{print $2}'
			fi
		)" || :
	else
		gentoo_stage3_id="$( # <- Syntax
			if [[ "${_container_engine}" == 'container' ]]; then
				apple_image_digest \
					"${gentoo_stage3_image}:${gentoo_stage3_tag}"
			else
				docker image ls --noheading \
						--format='{{.ID}}' \
					"${gentoo_stage3_image}:${gentoo_stage3_tag}" 2>/dev/null
			fi
		)" || :
	fi

	gentoo_stage3_image_ref="${gentoo_stage3_image}:${gentoo_stage3_tag}"
	[[ -z "${ref:-}" ]] ||
		gentoo_stage3_image_ref="${gentoo_stage3_image}@${ref}"
}  # prepare_gentoo_stage3_image

gentoo_stage3_tag='latest'
# https://hub.docker.com/r/gentoo/stage3 tag-naming is a mess - not only does
# it keep changing, but there's now an inconsistency as to whether the init
# system is tagged onto the image or not (for example, the amd64 image used to
# be 'amd64-nomultilib', which is now no longer being updated.  There are now
# new 'nomultilib' and 'amd64-nomultilib-openrc' images - while the 32bit image
# name has changed from 'x86' to 'i686-openrc' and the ARM image names are
# unchanged in the case of 'openrc' but now also have variants with a 'systemd'
# suffix)
# Update: As-of 18th March 2022, the 'arm64' image is no longer being updated,
# but the 'latest' image is now multi-arch, and there's an 'arm64-openrc' image
# also...
#
# shellcheck disable=SC2154
case "${docker_arch}" in
	'amd64')
		gentoo_stage3_tag="${docker_arch}-nomultilib-openrc" ;;
	'arm64')
		gentoo_stage3_tag="${docker_arch}-openrc" ;;
	'arm/v7')
		gentoo_stage3_tag='armv7a_hardfp-openrc' ;;
	'arm/v6')
		gentoo_stage3_tag='armv6j_hardfp-openrc' ;;
	'i386')
		gentoo_stage3_tag='i686-openrc' ;;
esac

declare gentoo_stage3_image='' gentoo_stage3_image_ref=''
declare gentoo_stage3_id='' ref=''
prepare_gentoo_stage3_image

# GCC's native driver expansion is deliberately verbose and changes as GCC
# learns about new target switches.  Run the shared semantic helpers inside the
# pinned stage3, then retain only options which change the named -march/-mcpu
# baseline.  The result remains suitable for distcc and for long-lived package
# cache metadata without encoding compiler-version defaults.
stage3_cpu_target_module="$(<../common/cpu-target.sh)"

stage3_gcc_reduce_target_options() {
	local compiler_options="${1:-}"
	local preferred_options="${2:-}"
	local reduce_script=''

	cpu_target_options_safe "${compiler_options}" || return 1
	if [[ -n "${preferred_options}" ]] &&
			! cpu_target_options_safe "${preferred_options}"
	then
		preferred_options=''
	fi
	reduce_script="set -eu
${stage3_cpu_target_module}
preferred_fingerprint=''
target_fingerprint=''
if [ -n \"\${PREFERRED_OPTIONS:-}\" ] &&
        preferred_fingerprint=\$( cpu_target_gcc_fingerprint \
            \"\${PREFERRED_OPTIONS}\" ) &&
        target_fingerprint=\$( cpu_target_gcc_fingerprint \
            \"\${TARGET_OPTIONS:-}\" ) &&
        [ \"\${preferred_fingerprint}\" = \"\${target_fingerprint}\" ]
then
    printf '%s\\n' \"\${PREFERRED_OPTIONS}\"
else
    cpu_target_reduce_gcc_options \"\${TARGET_OPTIONS:-}\"
fi
"
	docker container run \
		--entrypoint /bin/sh \
		--env "PREFERRED_OPTIONS=${preferred_options}" \
		--env "TARGET_OPTIONS=${compiler_options}" \
		--network none \
		--platform "linux/${docker_arch}" \
		--read-only \
		--rm \
		"${gentoo_stage3_image_ref}" -c "${reduce_script}"
}  # stage3_gcc_reduce_target_options

resolve_stage3_compiler_target() {
	local stage3_probe='' gcc_probe='' probed_opts='' reduced_opts=''
	local probed_cpu=''
	local probed_features='' raw_features='' detected_flags='' baseline_flags=''
	local model_cpu="${target_cpu:-}" model_rust_cpu="${target_cpu:-generic}"
	local required='' missing='' rust_required='' rust_missing=''
	local rust_base_opts='' retained_use='' use_word=''
	local probe_script=''

	probe_script="$( cat <<'EOF'
set -eu
printf '__CPU_FEATURES_BEGIN__\n'
awk -F':' '
    /^(flags|Features)[[:space:]]*:/ {
        delete current
        count = split($2, words, /[[:space:]]+/)
        for (word = 1; word <= count; word++) {
            if (words[word] != "") current[words[word]] = 1
        }
        if (records++ == 0) {
            for (feature in current) common[feature] = 1
        } else {
            for (feature in common) {
                if (!(feature in current)) delete common[feature]
            }
        }
    }
    END { for (feature in common) print feature }' /proc/cpuinfo
printf '__CPU_FEATURES_END__\n'
printf '__AUXV_BEGIN__\n'
env LD_SHOW_AUXV=1 /bin/true 2>&1 |
    awk '$1 == "AT_HWCAP:" || $1 == "AT_HWCAP2:" || $1 == "AT_HWCAP3:"'
printf '__AUXV_END__\n'
printf '__GCC_NATIVE_BEGIN__\n'
case "$( uname -m )" in
    x86_64|amd64|i?86|x86)
        gcc -march=native -mtune=native -### -E -x c /dev/null 2>&1
        ;;
    aarch64|arm64|arm*)
        gcc -mcpu=native -### -E -x c /dev/null 2>&1
        ;;
    *)
        exit 65
        ;;
esac
printf '__GCC_NATIVE_END__\n'
EOF
	)"

	if ! stage3_probe="$( # <- Syntax
		docker container run \
			--entrypoint /bin/sh \
			--network none \
			--platform "linux/${docker_arch}" \
			--read-only \
			--rm \
			"${gentoo_stage3_image_ref}" -c "${probe_script}" 2>&1
	)"
	then
		warn "Pinned stage3 compiler target probe failed; retaining validated" \
			"model or portable fallback '${cc_target_opts}'"
		printf >&2 '%s\n' "${stage3_probe}"
		return 0
	fi

	gcc_probe="$( # <- Syntax
		sed -n '/^__GCC_NATIVE_BEGIN__$/,/^__GCC_NATIVE_END__$/p' \
			<<<"${stage3_probe}" |
			sed '1d;$d'
	)"
	probed_opts="$( # <- Syntax
		printf '%s\n' "${gcc_probe}" |
			cpu_target_parse_gcc_native "${docker_arch}" || :
	)"
	probed_cpu="$( # <- Syntax
		cpu_target_from_compiler_options "${probed_opts}" || :
	)"
	raw_features="$( # <- Syntax
		sed -n '/^__CPU_FEATURES_BEGIN__$/,/^__CPU_FEATURES_END__$/p' \
			<<<"${stage3_probe}" |
			sed '1d;$d'
	)"
	probed_features="$( cpu_target_normalize_words "${raw_features}" )"

	if [[ -z "${probed_opts}" || -z "${probed_cpu}" ]] ||
			[[ " ${probed_opts} " == *native* ]]
	then
		warn "Pinned stage3 GCC did not produce a safe explicit native target;" \
			"retaining validated model or portable fallback '${cc_target_opts}'"
		return 0
	fi

	required="$( cpu_target_required_features \
		"${probed_cpu}" "${probed_opts}" '' "${use_cpu_arch}" )"
	missing="$( cpu_target_missing_features \
		"${probed_features}" "${required}" )"
	if [[ -n "${missing}" ]]; then
		warn "Pinned stage3 GCC target '${probed_opts}' requires features" \
			"'${missing}' absent from at least one available CPU; retaining" \
			"validated model or portable fallback '${cc_target_opts}'"
		return 0
	fi
	if ! reduced_opts="$( stage3_gcc_reduce_target_options \
			"${probed_opts}" "${cc_target_opts}" )" ||
			[[ -z "${reduced_opts}" ]] ||
			! cpu_target_options_safe "${reduced_opts}"
	then
		warn "Pinned stage3 GCC target could not be reduced to a safe" \
			"compiler-default-independent form; retaining validated model or" \
			"portable fallback '${cc_target_opts}'"
		return 0
	fi

	cc_target_opts="${reduced_opts}"
	target_cpu="${probed_cpu}"
	case "${docker_arch}" in
		amd64|i386) rust_base_opts="-march=${target_cpu}" ;;
		arm*) rust_base_opts="-mcpu=${target_cpu}" ;;
	esac
	rust_required="$( cpu_target_required_features \
		"${target_cpu}" "${rust_base_opts}" '' "${use_cpu_arch}" )"
	rust_missing="$( cpu_target_missing_features \
		"${cpu_exposed_features}" "${rust_required}" )"
	if cpu_target_rust_known_cpu "${target_cpu}" &&
			cpu_target_rust_mask_supported "${target_cpu}" "${rust_missing}"
	then
		model_rust_cpu="${target_cpu}"
	else
		model_rust_cpu='generic'
	fi
	rust_target_opts="$( cpu_target_rust_from_gcc \
		"${cc_target_opts}" "${target_cpu}" "${model_rust_cpu}" )"
	cpu_target_source='stage3-gcc-native'
	cpu_exposed_features="${probed_features}"
	info "Canonicalised pinned stage3 GCC native target to" \
		"'${cc_target_opts}' after verifying identical effective compiler state"

	detected_flags="$( cpu_target_gentoo_flags \
		"${cpu_exposed_features}" \
		"/var/db/repo/gentoo/profiles/desc/cpu_flags_${use_cpu_arch}.desc" )"
	baseline_flags="$( # <- Syntax
		(
			cpu_target_set_generic "${docker_arch}" >/dev/null 2>&1 || exit 0
			printf '%s\n' "${cpu_target_baseline_flags:-}"
		)
	)"
	use_cpu_flags_raw="$( cpu_target_normalize_words \
		"${baseline_flags} ${detected_flags}" )"
	use_cpu_flags=''
	if [[ -n "${use_cpu_flags_raw}" ]]; then
		use_cpu_flags="$( # <- Syntax
			printf '%s\n' "${use_cpu_flags_raw}" |
				sed "s/^/cpu_flags_${use_cpu_arch}_/ ; s/ / cpu_flags_${use_cpu_arch}_/g"
		)"
	fi

	# common/vars.sh has already assembled USE.  Replace only its CPU_FLAGS_*
	# terms so the gentoo-env metadata follows the stage3 capability boundary.
	for use_word in ${use_essential}; do
		case "${use_word}" in
			cpu_flags_arm_*|cpu_flags_x86_*) : ;;
			*) retained_use="${retained_use}${retained_use:+ }${use_word}" ;;
		esac
	done
	use_essential="${retained_use}${use_cpu_flags:+ ${use_cpu_flags}}"

	info "Pinned stage3 GCC resolved CPU target:" \
		"CPU_FLAGS_${use_cpu_arch}='${use_cpu_flags_raw}'," \
		"target_cpu='${target_cpu}'," \
		"compiler='${cc_target_opts}', rust='${rust_target_opts}'"
	if [[ -n "${model_cpu}" && "${model_cpu}" != "${target_cpu}" ]]; then
		note "Stage3 compiler target '${target_cpu}' supersedes host model" \
			"fallback '${model_cpu}'"
	fi
	if [[ -n "${debug:-}" ]]; then
		sed -n '/^__AUXV_BEGIN__$/,/^__AUXV_END__$/p' \
			<<<"${stage3_probe}"
	fi
}  # resolve_stage3_compiler_target

resolve_stage3_compiler_target
target_opt="${cc_target_opts:-}"
rust_target_opt="${rust_target_opts:-}"

if (( print_pkgdir_cache_affinity )); then
	pkgdir_generation_affinity_metadata
	printf 'CACHE_LABEL=%s\n' "$( pkgdir_generation_affinity_label )"
	exit 0
fi

if [[ "${_container_engine}" == 'container' ]]; then
	env_id="$( # <- Syntax
		apple_image_digest \
			"${env_name}:${override_tag:-"latest"}" 2>/dev/null || :
	)"
	local_stage3_id="$( # <- Syntax
		apple_image_digest \
			"${stage3_name}:${override_tag:-"latest"}" 2>/dev/null || :
	)"
else
	env_id="$( docker image ls --noheading \
			--format='{{.ID}}' \
		"${env_name}:${override_tag:-"latest"}"
	)" || die "Could not determine environment stage image name"
	local_stage3_id="$( docker image ls --noheading \
			--format='{{.ID}}' \
		"${stage3_name}:${override_tag:-"latest"}"
	)" || die "Could not determine local stage3 image name"
fi

[[ -n "${log_dir:-}" ]] || log_dir='log'
mkdir -p "${log_dir}" ||
	die "Could not create log directory '${log_dir}': ${?}"

# Create empty stage with shared environment variables ...
#
if [[ -z "${*:-}" ]] || grep -Fq -- ' --env ' <<<" ${*} "; then
	output
	# shellcheck disable=SC2154
	output " ${blue}*${reset} Creating image '${env_name}:${override_tag:-"latest"}' ..."
	output

	# NAME:    env
	# LABELS:
	# USES:
	# USED_BY: stage3 build

	declare -a build_args=()
	# shellcheck disable=SC2031,SC2207
	build_args+=( # <- Syntax
		--platform "linux/${docker_arch}"

		--build-arg SET_TERM="${TERM:-}"
		--build-arg SET_USE_ESSENTIAL="${use_essential:-}"
		--build-arg SET_USE_ESSENTIAL_GCC="${use_essential_gcc:-}"
		--build-arg JOBS="${JOBS:-}"
		--build-arg MAXLOAD="${MAXLOAD:-}"
		#--build-arg NICENESS="10"
		--build-arg MAIL_FROM="${mail_from:-}"
		--build-arg MAIL_TO="${mail_to:-}"
		--build-arg MAIL_MTA="${mail_mta:-}"

		--build-arg ARCH="${arch}"
		--build-arg PROFILE_PATH="${profile:-}"
		--build-arg CHOST="${chost:-}"
		--build-arg GENTOO_PKGHOST="${GENTOO_PKGHOST:-container}"
		--build-arg TARGET_CPU="${target_cpu}"
		--build-arg COMPILER_FAMILY="${compiler_family}"
		--build-arg TARGET_OPT="${target_opt}"
		--build-arg RUST_TARGET_OPT="${rust_target_opt}"
	)

	# shellcheck disable=SC2154
	[[ -z "${use_cpu_arch:-}" ]] || build_args+=( # <- Syntax
		--build-arg "CPU_FLAGS_${use_cpu_arch^^}=${use_cpu_flags_raw}"
	)
	declare cppflags='' cflags='' cxxflags='' ldflags='' \
		cgo_cppflags='' cgo_cflags='' cgo_cxxflags='' cgo_fflags='' \
		cgo_ldflags='' goflags='' \
		fflags='' fcflags='' flflags='' \
		rustflags=''
	if type -pf portageq >/dev/null 2>&1; then
		eval "$( resolve_gentoo_build_flags )"
	else
		# shellcheck disable=SC2030
		eval "$( resolve_non_gentoo_build_flags )"
	fi
	[[ -n "${cflags:-}" ]] || cflags='-O2 -pipe'
	[[ -n "${cxxflags:-}" ]] || cxxflags="${cflags}"
	[[ -n "${fflags:-}" ]] || fflags="${cflags}"
	[[ -n "${fcflags:-}" ]] || fcflags="${cflags}"
	if [[ -z "${ldflags:-}" ]]; then
		case "${arch}" in
			amd64|ppc64|x86)
				ldflags='-Wl,-O1 -Wl,--as-needed -Wl,-z,pack-relative-relocs'
				;;
			*)
				ldflags='-Wl,-O1 -Wl,--as-needed'
				;;
		esac
	fi
	[[ -n "${flflags:-}" ]] || flflags="${ldflags}"
	[[ -n "${cgo_cflags:-}" ]] || cgo_cflags="$( # <- Syntax
			go env 2>/dev/null |
					grep -F 'CGO_CFLAGS=' |
					cut -d"'" -f 2 |
					grep -x '.*' ||
				echo '-O2 -g -pipe'
		)"
	[[ -n "${cgo_cxxflags:-}" ]] || cgo_cxxflags="$( # <- Syntax
			go env 2>/dev/null |
					grep -F 'CGO_CXXFLAGS=' |
					cut -d"'" -f 2 |
					grep -x '.*' ||
				echo "${cgo_cflags:-}"
		)"
	[[ -n "${cgo_fflags:-}" ]] || cgo_fflags="$( # <- Syntax
			go env 2>/dev/null |
					grep -F 'CGO_FFLAGS=' |
					cut -d"'" -f 2 |
					grep -x '.*' ||
				echo "${cgo_cflags:-}"
		)"
	[[ -n "${cgo_ldflags:-}" ]] || cgo_ldflags="$( # <- Syntax
			go env 2>/dev/null |
					grep -F 'CGO_LDFLAGS=' |
					cut -d"'" -f 2 |
					grep -x '.*' ||
				echo "${cgo_cflags:-}"
		)"
	build_args+=( # <- Syntax
		--build-arg CPPFLAGS="${cppflags:-}"
		--build-arg CFLAGS="${cflags:-}"
		--build-arg CXXFLAGS="${cxxflags:-}"
		--build-arg FFLAGS="${fflags:-}"
		--build-arg FCFLAGS="${fcflags:-}"
		--build-arg FLFLAGS="${flflags:-}"
		--build-arg LDFLAGS="${ldflags:-}"
		--build-arg CGO_CPPFLAGS="${cgo_cppflags:-}"
		--build-arg CGO_CFLAGS="${cgo_cflags:-}"
		--build-arg CGO_CXXFLAGS="${cgo_cxxflags:-}"
		--build-arg CGO_FFLAGS="${cgo_fflags:-}"
		--build-arg CGO_LDFLAGS="${cgo_ldflags:-}"
		--build-arg GOFLAGS="${goflags:-}"
		--build-arg RUSTFLAGS="${rustflags:-}"
	)
	unset cppflags cflags cxxflags fflags fcflags flflags ldflags \
		cgo_cppflags cgo_cflags cgo_cxxflags cgo_fflags cgo_ldflags goflags \
		rustflags

	if [[ "${_container_engine}" == 'container' ]]; then
		build_args+=( # <- Syntax
			--file 'Dockerfile.env.apple'
			--no-cache
			--tag "${env_name}:${override_tag:-"latest"}"
		)
	else
		# shellcheck disable=SC2206
		[[ -z "${debug:-}" ]] || build_args+=( # <- Syntax
			--loglevel 3
			${DEBUG_EXTRA_ARGS:-}
		)

		# shellcheck disable=SC2207
		build_args+=( # <- Syntax
			--compress
			--file 'Dockerfile.env'
			--network none
			--no-cache
			$( # <- Syntax
					docker image build --squash-all --help >/dev/null 2>&1 &&
						echo '--squash-all' || :
				)
			--tag "${env_name}:${override_tag:-"latest"}"
			--rm
		)
	fi

	docker image build "${build_args[@]}" . 2>&1 |
		tee "${log_dir}/${env_name#*"/"}.log"
	output " -> ${?}"
	unset build_args

	[[ "${*:-}" = '--env' ]] && exit 0

	if [[ "${_container_engine}" == 'container' ]]; then
		env_id="$( # <- Syntax
			apple_image_digest "${env_name}:${override_tag:-"latest"}"
		)" || env_id="${env_name}:${override_tag:-"latest"}"
	else
		env_id="$( docker image ls --noheading \
				--format='{{.ID}}' \
			"${env_name}:${override_tag:-"latest"}" 2>/dev/null
		)"
	fi

	output
	output " ${blue}*${reset} Stage 'env' complete, next is 'stage3' ..."
	output
fi

if [[ -z "${*:-}" ]] || grep -Fq -- ' --stage3 ' <<<" ${*} "; then
	if [[ -z "${env_id:-}" ]]; then
		die "Environment stage not found - please run" \
			"'$( basename "${0}" ) --env'"
	fi

	output
	output " ${blue}*${reset} Creating image" \
		"'${stage3_name}:${override_tag:-"latest"}'" \
		"${debug:+"from image $( [[ "${_container_engine}" == 'container' ]] && printf digest || printf ID ) '${gentoo_stage3_id}' "}..."
	output

	# NAME:    stage3
	# LABELS:  environment-from stage3-from
	# USES:    [gentoo/stage3-amd64] env
	# USED_BY: init

	declare -a build_args=()
	if [[ 'symbolic link' == "$(
			if [[ "${_container_engine}" == 'container' ]]; then
				container_engine_run "${_command}" run --rm \
					--entrypoint /bin/sh \
					"${gentoo_stage3_image_ref}" -c "stat -c '%F' /lib"
			else
				docker run --rm --network none --entrypoint /bin/sh \
					"${gentoo_stage3_image_ref}" -c "stat -c '%F' /lib"
			fi
		)" ]]
	then
		build_args+=( --build-arg new_root_name="split-usr-root" )
	else
		build_args+=( --build-arg new_root_name="" )
	fi
	declare container_file=''
	container_file="$( select_file 'Dockerfile.stage3' )"
	# shellcheck disable=SC2207
	build_args+=( # <- Syntax
		--platform "linux/${docker_arch}"

		--build-arg BUILDKIT_PROGRESS="$(( debug ))"

		--build-arg ARCH="${arch}"

		--build-arg env_name="${env_name}"
		--build-arg env_id="${env_id}"
		--build-arg gentoo_stage3_image="${gentoo_stage3_image}"
		--build-arg gentoo_stage3_tag="${gentoo_stage3_tag}"
		--build-arg gentoo_stage3_id="${gentoo_stage3_id}"
		--build-arg gentoo_stage3_image_ref="${gentoo_stage3_image_ref}"
		--build-arg override_tag="${override_tag:-"latest"}"
	)
	[[ -z "${stage3_flags_file:-}" ]] || build_args+=( # <- Syntax
		--build-arg stage3_flags_file="${stage3_flags_file}"
	)

	if [[ "${_container_engine}" == 'container' ]]; then
		build_args+=( # <- syntax
			--file "${container_file}"
			--no-cache
			--tag "${stage3_name}:${override_tag:-"latest"}"
		)
	else
		# shellcheck disable=SC2206
		[[ -z "${debug:-}" ]] || build_args+=( # <- Syntax
			--loglevel 3
			${DEBUG_EXTRA_ARGS:-}
		)

		# shellcheck disable=SC2207
		build_args+=( # <- Syntax
			--compress
			--file "${container_file}"
			--network none
			--no-cache
			--pull=false
			$( # <- Syntax
					docker image build --squash --help >/dev/null 2>&1 &&
						echo '--squash'
				)
			--tag "${stage3_name}:${override_tag:-"latest"}"
		)
	fi

	docker image build "${build_args[@]}" . 2>&1 |
		tee "${log_dir}/${stage3_name#*"/"}.log"
	output " -> ${?}"
	unset container_file build_args

	# LABEL environment-from="${env_name}:${env_id}"
	# LABEL stage3-from="${gentoo_stage3_image}:${gentoo_stage3_id}"
	declare label=''
	if ! label="$( checklabel "${stage3_name}:${override_tag:-"latest"}" \
				'environment-from' \
				"${env_name}:${env_id}"
		)"
	then
		die "'environment-from' label '${label:-}' does not match intended" \
			"label '${env_name}:${env_id}' for image" \
			"${stage3_name}:${override_tag:-"latest"}"
	fi
	label=''
	if ! label="$( checklabel "${stage3_name}:${override_tag:-"latest"}" \
				'stage3-from' \
				"${gentoo_stage3_image}:${gentoo_stage3_id}"
		)"
	then
		die "'stage3-from' label '${label:-}' does not match intended label" \
			"'${gentoo_stage3_image}:${gentoo_stage3_id}' for image" \
			"${stage3_name}:${override_tag:-"latest"}"
	fi
	unset label

	[[ "${*:-}" == '--stage3' ]] && exit 0

	if [[ "${_container_engine}" == 'container' ]]; then
		local_stage3_id="$( # <- Syntax
			apple_image_digest "${stage3_name}:${override_tag:-"latest"}"
		)" || :
	else
		local_stage3_id="$( docker image ls --noheading \
				--format='{{.ID}}' \
			"${stage3_name}:${override_tag:-"latest"}" 2>/dev/null
		)"
	fi

	output
	output " ${blue}*${reset} Stage 'stage3' complete, next is 'init' ..."
	output
fi
unset ref

# Create initial image from Gentoo stage3 ...
#
# N.B. The first block below is executed if we DON'T have '--init' as an
#      argument, but may clear the command-line parameters so that the 'init'
#      block below that IS executed.
#
if [[ -n "${*:-}" ]] && ! grep -Fq -- ' --init ' <<<" ${*} "; then
	# Executed individually, `docker image ls` and `grep` both succeed.
	# With 'pipefail' disabled, the following test does the right thing.
	# However, with pipefail set the statement is interpreted to have
	# failed when run in the same pipeline?!
	#
	images="$( docker image ls --noheading \
		"${init_name}" 2>/dev/null
	)"
	if grep -Eq -- "^(localhost/)?${init_name}" <<<"${images}"; then
		imagesum="$( # <- Syntax
			if [[ "${_container_engine}" == 'container' ]]; then
				apple_image_label \
					"${init_name}:${override_tag:-"latest"}" \
					'entrypoint-sum'
			else
				docker image inspect \
						--format='{{index .Config.Labels "entrypoint-sum"}}' \
					"${init_name}:${override_tag:-"latest"}" 2>/dev/null
			fi
		)" || :
		if [[ "${imagesum:-}" != "${sum}" ]]; then
			if (( force )); then
				output >&2
				output >&2 "${bold}WARN${reset}:  ${red}'entrypoint.sh'" \
					"checksum from '${init_name}:${override_tag:-"latest"}'" \
					"image (${imagesum:-"<unknown>"}) does not match file on" \
					"disk (${sum}) - forcing continuation with existing" \
					"embedded script ...${reset}"
			else
				declare -i add_init=0
				for arg in "${@:-}"; do
					case "${arg:-}" in
						--env|--stage3|--init) : ;;
						*) add_init=1 ;;
					esac
				done
				if (( add_init )); then
					output >&2
					output >&2 "${bold}WARN${reset}:  ${red}'entrypoint.sh'" \
						"checksum from" \
						"'${init_name}:${override_tag:-"latest"}' image" \
						"(${imagesum:-"<unknown>"}) does not match file on" \
						"disk (${sum}) - rebuilding initial image ...${reset}"
					set -- "${@:-}" --init
				fi
				unset add_init
			fi
		fi
	else
		declare -i add_init=0
		for arg in "${@:-}"; do
			case "${arg:-}" in
				--env|--stage3|--init) : ;;
				*) add_init=1 ;;
			esac
		done
		if (( add_init )); then
			output >&2 "docker image '${init_name}' not found - rebuilding" \
				"initial image ..."
			set -- "${@:-}" --init
		fi
		unset add_init
	fi
fi

if [[ -z "${*:-}" ]] || grep -Fq -- ' --init ' <<<" ${*} "; then
	if [[ -z "${local_stage3_id:-}" ]]; then
		die "Local stage 3 image '${stage3_name}:${override_tag:-"latest"}'" \
			"not found - please execute '$( # <- Syntax
				basename "${0}"
			) --stage3'"
	fi

	output
	output " ${blue}*${reset} Creating image" \
		"'${init_name}:${override_tag:-"latest"}' ..."
	output

	checkids "${stage3_name}"

	# NAME:    init
	# LABELS:  stage3-from entrypoint-sum
	# USES:    stage3
	# USED_BY: base

	declare -a build_args=()
	declare container_file=''
	container_file="$( select_file 'Dockerfile.init' )"
	# shellcheck disable=SC2154,SC2207
	build_args+=( # <- Syntax
		--platform "linux/${docker_arch}"

		--build-arg BUILDKIT_PROGRESS="$(( debug ))"

		--build-arg ARCH="${arch}"

		--build-arg gentoo_stage3_image="${gentoo_stage3_image}"
		--build-arg gentoo_stage3_tag="${gentoo_stage3_tag}"
		--build-arg gentoo_stage3_id="${gentoo_stage3_id}"
		--build-arg stage3_name="${stage3_name}"
		--build-arg entrypoint_sum="${sum}"
		--build-arg override_tag="${override_tag:-"latest"}"

		--build-arg environment_filter="${environment_filter}"
	)
	[[ -z "${stage3_flags_file:-}" ]] || build_args+=( # <- Syntax
		--build-arg stage3_flags_file="${stage3_flags_file}"
	)
	[[ -z "${environment_file:-}" ]] || build_args+=( # <- Syntax
		--build-arg environment_file="${environment_file}"
	)

	if [[ "${_container_engine}" == 'container' ]]; then
		build_args+=( # <- syntax
			--file "${container_file}"
			--no-cache
			--tag "${init_name}:${override_tag:-"latest"}"
		)
	else
		# shellcheck disable=SC2206
		[[ -z "${debug:-}" ]] || build_args+=( # <- Syntax
			--loglevel 3
			${DEBUG_EXTRA_ARGS:-}
		)

		# shellcheck disable=SC2207
		build_args+=( # <- Syntax
			--compress
			--file "${container_file}"
			--network none
			--no-cache
			--pull=false
			$( # <- Syntax
					docker image build --squash --help >/dev/null 2>&1 &&
						echo '--squash'
				)
			--tag "${init_name}:${override_tag:-"latest"}"
		)
	fi

	docker image build "${build_args[@]}" . 2>&1 |
		tee "${log_dir}/${init_name#*"/"}.log"
	output " -> ${?}"
	unset container_file build_args

	# LABEL stage3-from="${gentoo_stage3_image}:${gentoo_stage3_id}"
	# LABEL entrypoint-sum="${entrypoint_sum}"
	declare label=''
	if ! label="$( checklabel "${init_name}:${override_tag:-"latest"}" \
				'stage3-from' \
				"${gentoo_stage3_image}:${gentoo_stage3_id}"
		)"
	then
		die "'stage3-from' label '${label:-}' does not match intended label" \
			"'${gentoo_stage3_image}:${gentoo_stage3_id}' for image" \
			"${init_name}:${override_tag:-"latest"}"
	fi
	label=''
	if ! label="$( checklabel "${init_name}:${override_tag:-"latest"}" \
				'entrypoint-sum' \
				"${sum}"
		)"
	then
		die "'entrypoint-sum' label '${label:-}' does not match intended" \
			"label '${sum}' for image ${init_name}:${override_tag:-"latest"}"
	fi
	unset label

	output
	output " ${blue}*${reset} Stage 'init' complete, next is 'base' ..."
	output
else
	checkids "${stage3_name}"
fi

# Launch initial image and run entrypoint script to install root @system, then
# snapshot the result to create a base image ...
#
if [[ -z "${*:-}" ]] || grep -Fq -- ' --base ' <<<" ${*} "; then
	images="$( docker image ls --noheading "${init_name}" 2>/dev/null )"
	if ! grep -Eq -- "^(localhost/)?${init_name#*"/"}" <<<"${images}"; then
		die "Initial stage not found - please execute '$( # <- Syntax
			basename "${0}"
		) --init'"
	fi

	output
	output " ${blue}*${reset} Deploying container '${base_name#*"/"}' from" \
		"image '${init_name}:${override_tag:-"latest"}' ..."
	output

	checkids "${init_name}"

	# Handle leftover container from previous run ...
	trap '' INT
	if docker container exists --external "${base_name#*"/"}"; then
		docker container stop "${base_name#*"/"}" >/dev/null 2>&1 || :
		docker container rm --volumes "${base_name#*"/"}" >/dev/null
	fi
	trap - INT

	# NAME:    base
	# LABELS:  (stage3-from) (entrypoint-sum)
	# USES:    (init)
	# USED_BY: build

	# For some reason, installing glibc to a ROOT results in valid libcrypt
	# symlinks being installed, but the actual libraries missing?!
	#
	(
		declare python_use='' python_pkgs=''

		if [[ -n "${python_single_target:-}" ]]; then
			declare pst='' pt=''

			python_use="python_single_target_${python_single_target}"
			pst="${python_single_target/" "*}"
			pst="${pst%"t"}"
			# shellcheck disable=SC2001
			python_pkgs="=python-$( sed 's/^python//' \
				<<<"${pst//_/.}" )*"
			unset pst

			for python_target in ${python_targets}; do
				pt="${python_target%"t"}"
				# shellcheck disable=SC2001
				python_pkgs+=" =python-$( sed 's/^python//' \
					<<<"${pt//_/.}" )*"
			done
			unset pt

			python_pkgs="$( # <- Syntax
					xargs -rn 1 <<<"${python_pkgs:-}" |
						sort -V |
						uniq |
						xargs -r
				)"

			declare -a docker_run_args=()
			docker_run_args+=( # <- Syntax
				--entrypoint /bin/sh
				--name 'buildpkg.stage3_flags.read'
				--network none
				--rm
			)
			eval "$( # <- Syntax
				docker container run "${docker_run_args[@]}" \
					"${init_name}:${override_tag:-"latest"}" -c \
						"cat ${stage3_flags_file}"
			)"
			unset docker_run_args

			declare mask_file=''
			if [[ -n "${arch:-}" ]] &&
				[[ -f "${base_dir}/etc/portage/profile/use.mask.${arch}" ]]
			then
				mask_file="${base_dir}/etc/portage/profile/use.mask.${arch}"
			fi
			[[ -z "${mask_file:-}" ]] &&
				mask_file="${base_dir}/etc/portage/profile/use.mask"
			if [[ -f "${mask_file}" ]]; then
				declare target=''
				if [[ -n "${STAGE3_PYTHON_SINGLE_TARGET:-}" ]]; then
					target="${STAGE3_PYTHON_SINGLE_TARGET}"
					if [[ "${target}" != "${python_single_target}" ]]; then
						if sed 's/#.*$//' "${mask_file}" |
							grep -qw -- "^python_targets_${target}"
						then
							die "Upstream stage python target" \
								"'python_single_target_${target}'" \
								"is masked by '${mask_file}'"
						fi
						python_use="$( replace_flags \
							"python_targets_${target}" -- "${python_use}"
						)"
					fi
				fi  # [[ -n "${STAGE3_PYTHON_SINGLE_TARGET:-}" ]]

				if [[ -n "${STAGE3_PYTHON_TARGETS:-}" ]]; then
					for target in ${STAGE3_PYTHON_TARGETS}; do
						for python_target in ${python_targets}; do
							if [[ "${target}" != "${python_target}" ]]; then
								if sed 's/#.*$//' "${mask_file}" |
									grep -qw -- "^python_targets_${target}"
								then
									die "Upstream stage python target" \
										"'python_targets_${target}'" \
										"is masked by '${mask_file}'"
								fi
								python_use="$( replace_flags \
									"python_targets_${target}" -- "${python_use}"
								)"
								# shellcheck disable=SC2001
								python_pkgs+=" =python-$( sed 's/^python//' \
									<<<"${python_target//_/.}" )*"
							fi
						done
					done
				fi
				unset target
			fi  # [[ -f "${mask_file}" ]]
			unset mask_file
		fi  # [[ -n "${python_target:-}" ]]

		# Add '@preserved-rebuild' for potential outdated stage3 base-images...
		post_pkgs='dev-util/pkgconf sys-libs/glibc @preserved-rebuild sys-apps/portage net-misc/curl dev-libs/nettle'
		post_use='curl_ssl_openssl -gmp multiarch native-extensions openssl ssl -ssp'
		if [[ -n "${python_use:-}" ]]; then
			# FIXME: libbsd is having a weird problem, during image-build only?
			post_pkgs+=' app-crypt/libmd dev-libs/libbsd'

			post_pkgs+=' dev-python/setuptools'
			post_use="$( replace_flags "${python_use}" -- "${post_use}" )"
		fi
		if type -pf portageq >/dev/null 2>&1; then
			portageq get_repos / | grep -Fq -- 'srcshelton' &&
				post_pkgs+=' sys-apps/gentoo-functions::srcshelton'
		else
			post_pkgs+=' sys-apps/gentoo-functions::srcshelton'
		fi
		# shellcheck disable=SC2030
		export name="${base_name#*"/"}"
		# shellcheck disable=SC2030
		export image="${init_name}:${override_tag:-"latest"}"
		# shellcheck disable=SC2031
		DOCKER_CMD_VARS="--env ARCH=${arch:-"${ARCH}"}"
		export DOCKER_CMD_VARS

		if [[ -d /var/lib/portage/eclass/linux-info ]]; then
			declare DOCKER_EXTRA_MOUNTS=''
			DOCKER_EXTRA_MOUNTS="$( # <- Syntax
					add_mount --dir --no-ro --print \
						'/var/lib/portage/eclass/linux-info' \
						'/srv/host/...'
				)"
			export DOCKER_EXTRA_MOUNTS
		fi

		declare -a docker_run_args=()
		docker_run_args+=( # <- Syntax
			--post-pkgs="${post_pkgs}"
			--post-use="${post_use}"
			--python-targets="${python_targets}"
			--usepkg=y
			--with-bdeps-auto=n
			--with-bdeps=n
		)
		# shellcheck disable=SC2086
		_docker_run "${docker_run_args[@]}" virtual/libc ${python_pkgs:-} 2>&1 |
			tee "${log_dir}/${base_name#*"/"}.log"
	)
	output " -> ${?}"

	output
	output " ${blue}*${reset} Saving container '${base_name#*"/"}' as image" \
		"'${base_name}:${override_tag:-"latest"}' ..."
	output

	# shellcheck disable=SC2086
	trap '' INT
	if [[ "${_container_engine}" == 'container' ]]; then
		apple_snapshot_container \
				"${base_name#*"/"}" \
				"${base_name}:${override_tag:-"latest"}" \
				"${log_dir}/${base_name#*"/"}.log" \
				"${init_name}:${override_tag:-"latest"}" \
				'Gentoo base image'
	elif [[ "${_container_engine}" == 'docker' ]]; then
		docker container commit 2>&1 \
				"${base_name#*"/"}" "${base_name}:${override_tag:-"latest"}" |
			tee -a "${log_dir}/${base_name#*"/"}.log"
	elif docker container commit --squash --help >/dev/null 2>&1; then
		docker container commit 2>&1 \
					--squash \
				"${base_name#*"/"}" "${base_name}:${override_tag:-"latest"}" |
			tee -a "${log_dir}/${base_name#*"/"}.log"
	else
		container_engine_run buildah commit 2>&1 \
					--squash \
				"${base_name#*"/"}" "${base_name}:${override_tag:-"latest"}" |
			tee -a "${log_dir}/${base_name#*"/"}.log"
	fi
	docker container rm --volumes "${base_name#*"/"}" 2>&1 |
		tee -a "${log_dir}/${base_name#*"/"}.log"
	trap - INT
	output " -> ${?}"

	output
	output " ${blue}*${reset} Stage 'base' complete, next is 'build' ..."
	output
else
	checkids "${init_name}"
fi

# Ensure that @system is correctly installed to ROOT=/ and snapshot result as
# build image.
if [[ -z "${*:-}" ]] || grep -Fq -- ' --build ' <<<" ${*} "; then
	declare -a container_args=()
	[[ -z "${IMAGE_ROOT:-}" ]] || container_args+=( # <- Syntax
		--storage-opt="overlay.imagestore=${GRAPH_ROOT}"
		--root "${IMAGE_ROOT}"
	)

	images="$( docker image ls --noheading \
		"${base_name}" 2>/dev/null
	)"
	if ! grep -Eq -- "^(localhost/)?${base_name}" <<<"${images}"; then
		die "Base stage not found - please execute '$( # <- Syntax
			basename "${0}"
		) --base'"
	fi

	output
	output " ${blue}*${reset} Deploying container '${build_name#*"/"}' ..."
	output

	checkids "${base_name}"

	# Handle leftover container from previous run ...
	trap '' INT
	# shellcheck disable=SC2015
	if docker container exists --external "${build_name#*"/"}"; then
		docker container stop "${build_name#*"/"}" >/dev/null 2>&1 || :
		docker container rm --volumes "${build_name#*"/"}"
	fi
	# shellcheck disable=SC2015
	if docker image ls --noheading \
			"${build_name}-root:${override_tag:-"latest"}" 2>/dev/null |
		grep -Eq -- \
			"^(localhost/)?${build_name}-root\s+${override_tag:-"latest"}\s"
	then
		docker "${container_args[@]}" image rm \
			"${build_name}-root:${override_tag:-"latest"}"
	fi
	trap - INT

	# NAME:    build
	# LABELS:  environment-from
	# USES:    base env
	# USED_BY: service

	# With the addition of the '--squash-all' parameter, we should end up
	# with chained 'env', 'stage3', 'init', and 'base' images; a unified
	# 'build' pre-image with one layer on top for the post-'container
	# build' changes which are committed below (as 'build') - and then
	# services are re-squashed when 'gentoo-build-svc.docker' invokes
	# 'Dockerfile.*service' to produce the service-container image.
	#
	declare -a build_args=()
	declare container_file=''
	declare package_use_local=''
	declare package_use_local_path='/etc/portage/package.use/01_package.use.local'
	container_file="$( select_file 'Dockerfile.build' )"
	# shellcheck disable=SC2207
	build_args+=( # <- Syntax
		--build-arg BUILDKIT_PROGRESS="$(( debug ))"

		--build-arg env_id="${env_id}"
		--build-arg override_tag="${override_tag:-"latest"}"

		--build-arg environment_filter="${environment_filter}"

		--build-arg ARCH="${arch}"
	)
	[[ -z "${environment_file:-}" ]] || build_args+=( # <- Syntax
		--build-arg environment_file="${environment_file}"
	)
	if [[ -e "${package_use_local_path}" ]]; then
		[[ -f "${package_use_local_path}" ]] &&
			[[ -s "${package_use_local_path}" ]] &&
			[[ -r "${package_use_local_path}" ]] ||
				die "Host package.use file '${package_use_local_path}' is not a" \
					"readable, non-empty regular file"
		package_use_local="$( # <- Syntax
				base64 < "${package_use_local_path}" | tr -d '\n'
			)" ||
			die "Could not encode host package.use file '${package_use_local_path}'"
		[[ -n "${package_use_local}" ]] ||
			die "Encoded host package.use file '${package_use_local_path}' is empty"
		info "Using host package.use file '${package_use_local_path}' for the" \
			"build image"
		build_args+=( --build-arg "package_use_local=${package_use_local}" )
	else
		info "Using repository package.use defaults for the build image"
	fi

	if [[ "${_container_engine}" == 'container' ]]; then
		build_args+=( # <- syntax
			--file "${container_file}"
			--no-cache
			--platform "linux/${docker_arch}"
			--tag "${build_name}-root:${override_tag:-"latest"}"
		)
	else
		# shellcheck disable=SC2206
		[[ -z "${debug:-}" ]] || build_args+=( # <- Syntax
			--loglevel 3
			${DEBUG_EXTRA_ARGS:-}
		)

		# shellcheck disable=SC2207
		build_args+=( # <- Syntax
			--compress
			--file "${container_file}"
			--network none
			--no-cache
			--platform "linux/${docker_arch}"
			$( # <- Syntax
					docker image build --squash-all --help >/dev/null 2>&1 &&
						echo '--squash-all' || :
				)
			--tag "${build_name}-root:${override_tag:-"latest"}"
		)
	fi

	docker "${container_args[@]}" image build "${build_args[@]}" . 2>&1 |
		tee "${log_dir}/${build_name#*"/"}.log"
	unset package_use_local_path package_use_local container_file build_args

	(
		# dev-libs/icu is needed for circular dependencies on
		#   icu -> python -> sqlite -> icu
		#
		# sys-libs/libeudev is needed to ensure correct dependencies in the
		# build root
		# FIXME: Which?
		#
		# sys-apps/sed is needed due to use of 'sed -z', which busybox doesn't
		# support
		#
		# Even though we want a minimal set of flags at this point, gcc's flags
		# are significant since they'll affect the compiler facilities
		# available to all packages built later...
		# FIXME: Source these flags from package.use
		#

		# FIXME: Expose this somewhere?
		features_libeudev=0
		features_eudev=0
		if (( features_eudev )); then
			eudev='sys-fs/eudev'
		elif (( features_libeudev )); then
			eudev='sys-libs/libeudev'
		else
			eudev='virtual/libudev'
		fi
		unset features_eudev features_libeudev

		# shellcheck disable=SC2031
		export name="${build_name#*"/"}"
		# shellcheck disable=SC2031
		export image="${build_name}-root:${override_tag:-"latest"}"
		# shellcheck disable=SC2030
		if [[ -n "${IMAGE_ROOT:-}" ]]; then
			export DOCKER_VARS="${container_args[*]}"
		fi
		# shellcheck disable=SC2086
		if docker ${DOCKER_VARS:-} container exists --external "${name}"; then
			warn "Container with name '${name}' already exists:"
			docker ${DOCKER_VARS:-} container ps --noheading -a |
				grep -F "${name}"
			docker ${DOCKER_VARS:-} container stop "${name}" || :
			docker ${DOCKER_VARS:-} container rm -v "${name}"
		fi
		declare -a build_args=()
		# shellcheck disable=SC2046
		build_args+=( # <- Syntax
			--post-use="-* $( replace_flags 'xattr' -- "${use_essential:-}" )"
			--update
			--usepkg=y
			--with-bdeps-auto=n
			--with-bdeps=n
			--with-use="-* $( replace_flags \
					'-lib-only' 'openmp' \
					'flex' 'pkg-config' \
					'curl_ssl_openssl' 'openssl' 'ssl' \
					"python_single_target_${python_single_target}" \
					$( # <- Syntax
						for python_target in ${python_targets}; do
							echo "python_targets_${python_target}"
						done
					) \
					"${pkg_pypy_use:+"python_targets_pypy3"}" \
					"${pkg_pypy_use:-}" \
				-- \
					"${use_essential:-} ${use_essential_gcc:-}"
			  )"
		)
		[[ -z "${pkg_pypy_post_remove:-}" ]] || build_args+=( # <- Syntax
			--post-remove="${pkg_pypy_post_remove}"
		)

		if [[ -d /var/lib/portage/eclass/linux-info ]]; then
			declare DOCKER_EXTRA_MOUNTS=''
			DOCKER_EXTRA_MOUNTS="$( # <- Syntax
					add_mount --dir --no-ro --print \
						'/var/lib/portage/eclass/linux-info' \
						'/srv/host/...'
				)"
			export DOCKER_EXTRA_MOUNTS
		fi

		# @system includes virtual/ssh, which sometimes tries to pull-in
		# net-misc/dropbear rather than net-misc/openssh, so include the latter
		# to try to avoid this...
		#
		# Update: Add sys-devel/dwz & dev-util/debugedit to support optional
		#         portage FEATURES 'dedupdebug' & 'installsources'
		#
		# shellcheck disable=SC2086
		_docker_run "${build_args[@]}" --exclude='net-misc/dropbear' \
				dev-libs/icu dev-util/debugedit dev-util/pkgconf \
				net-misc/openssh sys-apps/locale-gen sys-apps/sed \
				sys-apps/util-linux sys-devel/dwz sys-devel/gcc \
				${eudev} @system \
				${pkg_pypy:+"sys-apps/portage"} ${pkg_pypy:-} 2>&1 |
			tee -a "${log_dir}/${build_name#*"/"}.log"
		unset build_args
	)
	output " -> ${?}"

	output
	output " ${blue}*${reset} Saving container '${build_name#*"/"}' as image" \
		"'${build_name}-finalise:${override_tag:-"latest"}' ..."
	output
	trap '' INT
	# shellcheck disable=SC2031,SC2086,SC2140
	if [[ "${_container_engine}" == 'container' ]]; then
		apple_snapshot_container \
				"${build_name#*"/"}" \
				"${build_name}-finalise:${override_tag:-"latest"}" \
				"${log_dir}/${build_name#*"/"}.log" \
				"${build_name}-root:${override_tag:-"latest"}" \
				'Gentoo build finalisation image'
	elif [[ "${_container_engine}" == 'docker' ]]; then
		docker "${container_args[@]}" container commit \
				"${build_name#*"/"}" \
					"${build_name}-finalise:${override_tag:-"latest"}" |
			tee -a "${log_dir}/${build_name#*"/"}.log"
	elif docker container commit --squash --help >/dev/null 2>&1; then
		docker "${container_args[@]}" container commit \
					--squash \
				"${build_name#*"/"}" \
					"${build_name}-finalise:${override_tag:-"latest"}" |
			tee -a "${log_dir}/${build_name#*"/"}.log"
	else
		container_engine_run buildah "${container_args[@]}" commit \
					--squash \
				"${build_name#*"/"}" \
					"${build_name}-finalise:${override_tag:-"latest"}" |
			tee -a "${log_dir}/${build_name#*"/"}.log"
	fi
	# shellcheck disable=SC2031,SC2086,SC2140
	docker "${container_args[@]}" container rm --volumes "${build_name#*"/"}" |
		tee -a "${log_dir}/${build_name#*"/"}.log"
	# shellcheck disable=SC2031,SC2086,SC2140
	docker "${container_args[@]}" image rm \
			"${build_name}-root:${override_tag:-"latest"}" |
		tee -a "${log_dir}/${build_name#*"/"}.log"
	output " -> ${?}"
	trap - INT

	# This is a potentially expensive additional step, but it ensures that
	# portage doesn't complain noisily if the repos which exist on-disk when
	# a build-container is run are fewer or different than those which existed
	# when the build-image was assembled...
	#
	output
	output " ${blue}*${reset} Finalising image " \
		"'${build_name#*"/"}-finalise:${override_tag:-"latest"}' ..."
	output
	trap '' INT
	docker "${container_args[@]}" container run \
				--name "${build_name#*"/"}-finalise" \
				--net none \
			"${build_name}-finalise:${override_tag:-"latest"}" \
				--finalise-container |
		tee -a "${log_dir}/${build_name#*"/"}.log"
	output " -> ${?}"
	trap - INT

	output
	output " ${blue}*${reset} Saving container '${build_name#*"/"}-finalise'" \
		"as image '${build_name}:${override_tag:-"latest"}' ..."
	output
	trap '' INT
	# shellcheck disable=SC2031,SC2086,SC2140
	if [[ "${_container_engine}" == 'container' ]]; then
		apple_snapshot_container \
				"${build_name#*"/"}-finalise" \
				"${build_name}:${override_tag:-"latest"}" \
				"${log_dir}/${build_name#*"/"}.log" \
				"${build_name}-finalise:${override_tag:-"latest"}" \
				'Gentoo build image'
	elif [[ "${_container_engine}" == 'docker' ]]; then
		docker "${container_args[@]}" container commit \
				"${build_name#*"/"}-finalise" \
					"${build_name}:${override_tag:-"latest"}" |
			tee -a "${log_dir}/${build_name#*"/"}.log"
	elif docker container commit --squash --help >/dev/null 2>&1; then
		docker "${container_args[@]}" container commit \
					--squash \
				"${build_name#*"/"}-finalise" \
					"${build_name}:${override_tag:-"latest"}" |
			tee -a "${log_dir}/${build_name#*"/"}.log"
	else
		container_engine_run buildah "${container_args[@]}" commit \
					--squash \
				"${build_name#*"/"}-finalise" \
					"${build_name}:${override_tag:-"latest"}" |
			tee -a "${log_dir}/${build_name#*"/"}.log"
	fi
	# shellcheck disable=SC2031,SC2086,SC2140
	docker "${container_args[@]}" container rm --volumes \
			"${build_name#*"/"}-finalise" |
		tee -a "${log_dir}/${build_name#*"/"}.log"
	# shellcheck disable=SC2031,SC2086,SC2140
	docker "${container_args[@]}" image rm \
			"${build_name}-finalise:${override_tag:-"latest"}" |
		tee -a "${log_dir}/${build_name#*"/"}.log"
	output " -> ${?}"
	trap - INT

	unset container_args

	# LABEL environment-from="${env_name}:${env_id}"
	declare label=''
	if ! label="$( checklabel "${build_name}:${override_tag:-"latest"}" \
				'environment-from' \
				"${env_name}:${env_id}"
		)"
	then
		die "'environment-from' label '${label:-}' does not match intended" \
			"label '${env_name}:${env_id}' for image" \
			"${build_name}:${override_tag:-"latest"}"
	fi
	unset label

	output
	output " ${blue}*${reset} Stage 'build' complete - all done"
	output
else
	checkids "${base_name}"
fi

if [[ -z "${*:-}" ]] ||
		(( build_helper )) ||
		grep -Fq -- ' --force-helper ' <<<" ${*} "
then
	if type -pf portageq >/dev/null 2>&1; then
		# Running on Gentoo...

		if (( build_helper )); then
			if (( force )) || grep -Fq -- ' --force-helper ' <<<" ${*} "; then
				warn "Forcing creation of unnecessary helper image on Gentoo" \
					"platform"
			else
				die "Helper image unneeded on Gentoo platform - use" \
					"'--force' to enable creation"
			fi
		else
			build_helper=0
		fi
	fi

	if (( build_helper )); then
		# Return from ${base_dir}
		popd >/dev/null 2>&1 || exit 1
		if ! [[ -x gentoo-build-svc.docker ]]; then
			warn "Cannot execute 'gentoo-build-svc.docker' script (in" \
				"directory '${PWD}') to build non-Gentoo helper image"
		else
			#if ! ((
			#	docker image ls --noheading \
			#			"gentoo-helper:${override_tag:-"latest"}" 2>/dev/null |
			#		wc -l
			#)); then
				output " ${blue}*${reset} Building helper for non-Gentoo" \
					"host systems ..."
				output

				if
					(( force )) ||
						grep -Fq -- ' --force-helper ' <<<" ${*} "
				then
					./gentoo-build-svc.docker eix --force
				else
					./gentoo-build-svc.docker eix
				fi
				output " -> ${?}"
			#fi
		fi
	fi
fi

[[ -z "${trace:-}" ]] || set +o xtrace

# Return from ${base_dir} or error if (( build_helper ))...
popd >/dev/null 2>&1 || :

exit 0

# vi: set colorcolumn=80 foldmarker=()\ {,}\ \ #\  foldmethod=marker syntax=bash sw=4 ts=4:
